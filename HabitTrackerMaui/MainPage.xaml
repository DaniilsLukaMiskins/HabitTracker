<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HabitTrackerMaui.ViewModels"
             x:Class="HabitTrackerMaui.MainPage"
             x:DataType="vm:HabitsViewModel"
             Title="Mani ieradumi">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label Text="Aktīvie ieradumi" FontSize="26" FontAttributes="Bold" />
            <Label Text="Lietotājs: user-1" />
            <Label Text="{Binding TodayText}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding IsNotBusy}">
            <Button Text="Jauns ieradums" Command="{Binding CreateCommand}" IsEnabled="{Binding IsLoaded}" />
            <Button Grid.Column="1" Text="Atjaunot" Command="{Binding LoadCommand}" />
        </Grid>
        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <CollectionView Grid.Row="4" ItemsSource="{Binding Habits}" SelectionMode="None"
                        IsEnabled="{Binding IsNotBusy}" EmptyView="{Binding EmptyMessage}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HabitListItem">
                    <Border Padding="16" Margin="0,0,0,12" StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#D5D2DC, Dark=#605D66}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding FrequencyText}" />
                            <Label Text="{Binding TodayStatus}" FontAttributes="Bold" />
                            <Button Text="Atvērt ieradumu" CommandParameter="{Binding .}"
                                    Command="{Binding OpenDetailsCommand, Source={RelativeSource AncestorType={x:Type vm:HabitsViewModel}}, x:DataType=vm:HabitsViewModel}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
